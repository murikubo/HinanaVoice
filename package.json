{
  "name": "hinana-voice",
  "version": "0.11.0",
  "private": true,
  "description": "GPT, VOICEPEAK, VB-CABLE 및 Vocoflex용 음성 대화 프로그램",
  "author": "비나래",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "setup": "node scripts/setup-dev.js",
    "build:voice-studio": "node scripts/build-vocoflex-lab.js",
    "build:backend": "node scripts/build-backend.js",
    "pack": "electron-builder --dir",
    "dist": "npm run build:backend && electron-builder"
  },
  "devDependencies": {
    "electron": "43.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.hinanavoice.app",
    "productName": "Hinana Voice",
    "copyright": "비나래",
    "icon": "icon.png",
    "files": [
      "electron/**/*",
      "icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "hinana_bridge.py",
        "to": "backend/hinana_bridge.py"
      },
      {
        "from": "hinana_voice.py",
        "to": "backend/hinana_voice.py"
      },
      {
        "from": "requirements.txt",
        "to": "backend/requirements.txt"
      },
      {
        "from": "platform_support.py",
        "to": "backend/platform_support.py"
      },
      {
        "from": "voice_studio.py",
        "to": "backend/voice_studio.py"
      },
      {
        "from": "live_voice.py",
        "to": "backend/live_voice.py"
      },
      { "from": "standalone_vocoflex.py", "to": "backend/standalone_vocoflex.py" },
      {
        "from": "backend-bin",
        "to": "backend/bin",
        "filter": [
          "hinana-backend*",
          "vocoflex-host",
          "VocoflexHost.app/**/*"
        ]
      }
    ],
    "win": {
      "icon": "icon.png",
      "target": "portable"
    },
    "mac": {
      "icon": "icon.png",
      "target": "dmg",
      "category": "public.app-category.entertainment",
      "hardenedRuntime": true,
      "extendInfo": { "NSMicrophoneUsageDescription": "선택한 마이크 또는 가상 케이블 음성을 분석하고 Vocoflex로 실시간 변환합니다." },
      "gatekeeperAssess": false
    }
  }
}
